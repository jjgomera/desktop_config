conky.config = {
--!/usr/bin/conky -c


-- Use Xft?
	use_xft = true,
	font = 'Dejavu Sans Mono:size=9',

-- Update interval in seconds
	update_interval = 5,

-- This is the number of times Conky will update before quitting.
-- Set to zero to run forever.
	total_run_times = 0,

-- Create own window instead of using desktop (required in nautilus)
	own_window = true,
	own_window_transparent = true,
	own_window_type = 'desktop',
	own_window_hints = 'undecorated,above,sticky,skip_taskbar,skip_pager',
	own_window_title = 'conkybarra',


-- Use double buffering (reduces flicker, may not work for everyone)
	double_buffer = true,

-- Minimum size of text area
	minimum_width = 30, minimum_height = 10,
	maximum_width = 2000,

-- Draw shades?
	draw_shades = false,

-- Draw outlines?
	draw_outline = false,

-- Draw borders around text
	draw_borders = false,

-- Stippled borders?
	stippled_borders = 0,

-- border width
	border_width = 0,

-- Default colors and also border colors
	default_color = '#606060',
--default_shade_color white
--default_outline_color black
	own_window_colour = '#181818',

	color1 = '#dddddd',--etiquetas
	color2 = '#dddddd',--datos
	color3 = '#ffffff',--clock

-- Text alignment, other possible values are commented
--alignment top_left
--alignment top_right
--alignment bottom_left
	alignment = 'bottom_right',

-- Gap between borders of screen and text
-- same thing as passing -x at command line
	gap_x = 0,
	gap_y = 0,

-- Subtract file system buffers from used memory?
	no_buffers = true,

-- set to yes if you want all text to be in uppercase
	uppercase = false,
	short_units = true,

-- number of cpu samples to average
-- set to 1 to disable averaging
	cpu_avg_samples = 2,

-- number of net samples to average
-- set to 1 to disable averaging
	net_avg_samples = 1,

-- Force UTF8? note that UTF8 support required XFT
	override_utf8_locale = true,

-- Add spaces to keep things from moving about?  This only affects certain objects.
	use_spacer = 'right',

};

conky.text = [[
${color2}${execpi 5 sensors | grep temp1 | head -n1 | cut -d" " -f9 | cut -b 2-8 | xargs ~/configuracion/colorize.sh}$font${color}${tab}${tab}cpu: ${cpugraph 12,50 404040 404040} ${goto 120}$color2${cpu}%${goto 170}${color}ram: ${memgraph 12,50 404040 404040} ${goto 220}$color2${memperc}%${color}${goto 270}io: ${diskiograph 12,50 404040 404040}${tab}${tab}${color}${font Littlearrows:size=15}C$font ${voffset -3}$color2${downspeed wlp1s0}${color} ${downspeedgraph wlp1s0 12,60 404040 404040 700}${tab}${tab}${color}${voffset -3}${font Littlearrows:size=15}A$font ${voffset -3} $color2${upspeed wlp1s0}${color} ${upspeedgraph wlp1s0 12,60 404040 404040 70}${voffset -2}${tab}${tab}$color3${font LCDMono:size=10}${time %H:%M} 
]];
